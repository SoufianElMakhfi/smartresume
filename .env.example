# Einfacher: In der App unter „KI einrichten“ eintragen – die App schreibt diese Datei dann selbst.
# Alle Keys sind optional. Kostenlos: Gemini (https://aistudio.google.com/apikey), Groq (https://console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=
# Mistral (https://console.mistral.ai/api-keys, Prepaid-Guthaben ab 10 €)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Login-Codes per E-Mail (optional – ohne SMTP zeigt die App den Code lokal direkt an)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = App-Passwort
#        (https://myaccount.google.com/apppasswords, 2-Faktor muss aktiv sein)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Öffentliche Adresse der App für den Login-Link in der Mail (lokal nicht nötig)
SMARTRESUME_URL=
